      "parameters": {
        "jsCode": "// Master Post Execution Collector & Formatter\nconst post = $('Split in Batches (1 by 1)').first().json;\nconst prep = $('Media Prep & Normalizer').first().json;\n\nfunction evaluatePlatform(nodeName, label) {\n  try {\n    const nodeData = $(nodeName).first();\n    if (!nodeData) return { label, status: 'SKIPPED', id: '', error: 'Not executed or routed away' };\n    if (nodeData.error) return { label, status: 'FAILED', id: '', error: nodeData.error.message || 'API Error' };\n    \n    const json = nodeData.json || {};\n    const id = json.id || json.publish_id || json.urn || json.media_id || json.post_id || 'OK';\n    return { label, status: 'SUCCESS', id: String(id), error: '' };\n  } catch (e) {\n    return { label, status: 'NOT_RUN', id: '', error: e.message };\n  }\n}\n\nconst reports = [\n  evaluatePlatform('YouTube: Upload Long Video', 'YouTube_Long'),\n  evaluatePlatform('YouTube: Upload Short', 'YouTube_Short'),\n  evaluatePlatform('Instagram: Publish Post', 'Instagram'),\n  evaluatePlatform('Facebook: Publish Page Post', 'Facebook'),\n  evaluatePlatform('LinkedIn: Share Post', 'LinkedIn'),\n  evaluatePlatform('TikTok: Push Video to Inbox', 'TikTok'),\n  evaluatePlatform('Pinterest: Create Pin', 'Pinterest'),\n  evaluatePlatform('Twitter/X: Post Tweet', 'Twitter_X')\n];\n\nconst successes = reports.filter(r => r.status === 'SUCCESS').map(r => r.label);\nconst failures = reports.filter(r => r.status === 'FAILED').map(r => `${r.label}: ${r.error}`);\n\nlet overallStatus = 'posted';\nif (failures.length > 0 && successes.length > 0) {\n  overallStatus = 'partial';\n} else if (failures.length > 0 && successes.length === 0) {\n  overallStatus = 'failed';\n}\n\nreturn [{\n  json: {\n    content_id: post.content_id || post.title,\n    title: post.title,\n    overall_status: overallStatus,\n    success_count: successes.length,\n    failure_count: failures.length,\n    success_channels: successes.join(', '),\n    failure_details: failures.join(' | '),\n    public_media_url: prep.public_media_url,\n    processed_at: new Date().toISOString(),\n    reports: reports\n  }\n}];"
      },
