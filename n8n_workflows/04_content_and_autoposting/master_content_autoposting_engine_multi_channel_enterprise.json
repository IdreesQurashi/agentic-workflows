    {
      "parameters": {
        "jsCode": "// Prepare unified payload with binary data AND direct public URL\nconst postItem = $('Split in Batches (1 by 1)').first().json;\nconst driveItem = $input.first()?.json || {};\nconst binaryData = $('Download Media to Binary').first()?.binary;\n\n// Construct direct downloadable / streamable Google Drive public link\n// Fallback to original URL if drive upload skipped\nlet fileId = driveItem.id || driveItem.fileId || '';\nlet publicUrl = fileId \n  ? `https://drive.google.com/uc?export=download&id=${fileId}` \n  : (postItem.media_source_url || '');\n\nconst title = postItem.title || 'New Update';\nconst caption = postItem.caption || postItem.text || '';\nconst hashtags = postItem.hashtags ? `\\n\\n${postItem.hashtags}` : '';\nconst fullText = `${caption}${hashtags}`.trim();\nconst postType = (postItem.post_type || 'all').toLowerCase();\nconst platforms = (postItem.platforms || 'all').toLowerCase();\n\nreturn [{\n  json: {\n    ...postItem,\n    full_text: fullText,\n    public_media_url: publicUrl,\n    google_drive_file_id: fileId,\n    has_binary: !!binaryData,\n    post_type: postType,\n    platforms: platforms,\n    is_video: postType === 'video' || postType === 'short' || postType === 'reel',\n    is_short: postType === 'short',\n    execution_time: new Date().toISOString()\n  },\n  binary: binaryData || {}\n}];"
      },
