    {
      "parameters": {
        "jsCode": "let items = $input.all();\nlet parsedItems = items.map(item => {\n  let textString = \"\";\n  if (item.json.content && item.json.content.parts && item.json.content.parts[0]) {\n      textString = item.json.content.parts[0].text || \"\";\n  } else if (typeof item.json.content === \"string\") {\n      textString = item.json.content;\n  } else {\n      textString = JSON.stringify(item.json.content);\n  }\n  \n  const match = textString.match(/([\\s\\S]*?)(?:[\\r\\n\\s-]+[Rr]ating:\\s*|[\\r\\n]+)(\\d+(?:\\/\\d+)?)\\s*$/);\n  \n  if (match) {\n    let rawRating = match[2].includes('/') ? match[2].split('/')[0] : match[2];\n    return {\n      json: {\n        data: match[1].trim(),\n        rating: parseFloat(rawRating) || 0\n      }\n    };\n  } else {\n    return {\n      json: {\n        data: textString,\n        rating: 0\n      }\n    };\n  }\n});\n\n// Sort by rating descending (highest first)\nparsedItems.sort((a, b) => b.json.rating - a.json.rating);\n\n// Return exactly the top 5 posts\nreturn parsedItems.slice(0, 5);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2096,
        16
      ],
      "id": "1ff7da0e-b135-47f4-b89d-4e02853f010b",
      "name": "Top 5 posts filter V2"
