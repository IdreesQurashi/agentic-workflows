        "messages": {
          "values": [
            {
              "content": "You are a ruthlessly objective AI trend analyst. Your function is to evaluate the viral potential, market disruption, and real-world impact of AI news.",
              "role": "model"
            },
            {
              "content": "==Evaluate the following AI news summary and score its importance on a scale of 1 to 10. \n\nSCORING CRITERIA:\n- 1-3: Trivial updates, minor bug fixes, low impact.\n- 4-6: Moderate interest, incremental improvements.\n- 7-8: Major feature releases, strong market impact, highly shareable.\n- 9-10: Paradigm-shifting breakthroughs, massive industry disruption.\n\nSTRICT OUTPUT FORMAT:\nYou must return the exact summary text provided, followed by two newlines, and then exactly \"Rating: X\" (where X is your numerical score). Do not add any other words.\n\nExample Output:\nThis is the exact summary text that you received.\n\nRating: 8\n\nHere is the summary to evaluate:\n{{ $json.content.parts[0].text }}"
            }
          ]
        },
        "builtInTools": {
          "codeExecution": false
        },
        "options": {}
      },
