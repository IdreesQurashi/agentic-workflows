    {
      "parameters": {
        "jsCode": "let items = $input.all();\n\n// Use HTML formatting since Gmail renders the email as HTML\nlet combinedText = \"<h2>Here are the top AI news for today:</h2><br>\";\n\n// Loop through the items and stitch them together with HTML breaks\nitems.forEach((item, index) => {\n  combinedText += `<b>${index + 1}.</b> ${item.json.data}<br><br>`;\n  \n  // Adds a clean horizontal divider line between posts\n  combinedText += `<hr><br>`;\n});\n\n// Return a single item so the next node (Gmail) only runs once\nreturn [{\n  json: {\n    data: combinedText\n  }\n}];"
      },
