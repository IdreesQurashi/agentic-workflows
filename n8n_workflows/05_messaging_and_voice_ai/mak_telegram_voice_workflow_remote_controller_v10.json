    {
      "id": "node-format-status-msg",
      "name": "Format Status Query Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2272,
        512
      ],
      "parameters": {
        "jsCode": "const prev = $('Unpack AI Decision').item.json;\nconst execData = $input.first().json.data || [];\n\nconst lines = execData.slice(0, 5).map(e => {\n  const statusEmoji = e.status === 'success' ? '\ud83d\udfe2' : e.status === 'running' ? '\ud83d\udfe1' : '\ud83d\udd34';\n  const mode = e.mode || 'webhook';\n  return `${statusEmoji} *#${e.id}* \u2014 ${e.status.toUpperCase()} (${mode})`;\n}).join('\\n') || '\u2022 No recent execution records found.';\n\nconst text = `\ud83d\udcca *N8N SYSTEM RECENT EXECUTIONS*\\n\\n` +\n  `${lines}\\n\\n` +\n  `Host: \\`localhost:5678\\`\\n` +\n  `Checked at: ${new Date().toLocaleTimeString('en-US', { timeZone: 'America/Chicago' })} CDT`;\n\nreturn [{ json: { chatId: prev.chatId, message: text } }];"
      }
    },
