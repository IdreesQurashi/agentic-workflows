    {
      "id": "node-format-success-msg",
      "name": "Format Trigger Success Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        16
      ],
      "parameters": {
        "jsCode": "const prev = $('Unpack AI Decision').item.json;\n\nconst text = `\u26a1 *WORKFLOW TRIGGERED SUCCESS*\\n\\n` +\n  `\ud83c\udfaf *Workflow:* ${prev.targetWorkflow ? prev.targetWorkflow.name : 'Requested Automation'}\\n` +\n  `\ud83c\udf99 *Input Mode:* ${prev.sourceMode === 'voice_memo' ? 'Voice Memo' : 'Text Command'}\\n` +\n  `\ud83d\udcdd *Original Ask:* \\\"${prev.commandText}\\\"\\n` +\n  `\u23f1 *Executed At:* ${new Date().toLocaleTimeString('en-US', { timeZone: 'America/Chicago' })} Houston Time\\n` +\n  `\ud83d\udfe2 *Status:* Webhook dispatched successfully\\n\\n` +\n  `_Remote control execution complete._`;\n\nreturn [{ json: { chatId: prev.chatId, message: text } }];"
      }
    },
