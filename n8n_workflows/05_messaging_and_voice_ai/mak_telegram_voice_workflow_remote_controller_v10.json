        "jsCode": "const prev = $input.first().json;\n\nconst text = `\ud83e\udde0 *SAVED TO MAK 2ND BRAIN*\\n\\n` +\n  `\ud83d\udcc1 *Category:* ${prev.captureType}\\n` +\n  `\ud83d\udccc *Title:* ${prev.parsedTitle}\\n` +\n  `\ud83c\udf99 *Captured via:* ${prev.sourceMode === 'voice_memo' ? 'Telegram Voice Memo' : 'Telegram Text'}\\n` +\n  `\ud83d\udcdd *Summary:*\\n\\\"${prev.summary || prev.commandText}\\\"\\n\\n` +\n  `_Logged to memory store. Ready for triage._`;\n\nreturn [{ json: { chatId: prev.chatId, message: text } }];"
