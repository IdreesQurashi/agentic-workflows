    {
      "id": "node-auth-gate",
      "name": "Security & Type Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        304
      ],
      "parameters": {
        "jsCode": "// Security Gate: Verify Telegram Sender Identity\nconst msg = $input.first().json.message || {};\nconst senderId = String(msg.from?.id || msg.chat?.id || \"\");\nconst senderName = msg.from?.first_name || msg.from?.username || \"Unknown\";\n\n// Whitelist of authorized Telegram Chat IDs (Your ID: 8590198563)\nconst allowedIds = [\"8590198563\"];\n\n// Check whitelist authorization\nconst isAuthorized = allowedIds.length === 0 || allowedIds.includes(senderId);\n\nconst isVoice = Boolean(msg.voice || msg.audio);\nconst isText = Boolean(msg.text);\nconst fileId = msg.voice?.file_id || msg.audio?.file_id || null;\nconst rawText = msg.text || msg.caption || \"\";\nconst chatId = msg.chat?.id || msg.from?.id;\n\nreturn [{\n  json: {\n    isAuthorized,\n    senderId,\n    senderName,\n    chatId,\n    isVoice,\n    isText,\n    fileId,\n    rawText,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      }
    },
