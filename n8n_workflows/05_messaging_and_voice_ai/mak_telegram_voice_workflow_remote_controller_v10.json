    {
      "id": "node-unpack-ai-decision",
      "name": "Unpack AI Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        240
      ],
      "parameters": {
        "jsCode": "const unify = $('Unify Command Text').item.json;\nconst rawItem = $input.first().json;\nlet rawText = rawItem.mergedResponse || rawItem.content?.parts?.[0]?.text || rawItem.text || '';\n\nrawText = rawText.replace(/```json\\s*/gi, '').replace(/```\\s*/g, '').trim();\n\nlet ai = {};\nif (rawText) {\n  try {\n    ai = JSON.parse(rawText);\n  } catch (e) {}\n}\n\nif (!ai.intent) {\n  const text = (unify.commandText || '').toLowerCase();\n  if (text.includes('health') || text.includes('backup') || text.includes('router') || text.includes('digest')) {\n    let wf = null;\n    if (text.includes('health')) wf = { id: 'health_monitor', name: 'n8n Daily Health Monitor', webhookUrl: 'http://localhost:5678/webhook/n8n-health-check' };\n    else if (text.includes('backup')) wf = { id: 'backup_engine', name: 'Pre-Update Automated Backup', webhookUrl: 'http://localhost:5678/webhook/trigger-pre-update-backup' };\n    else if (text.includes('router')) wf = { id: 'jev_router', name: 'Router Shell v1', webhookUrl: 'http://localhost:5678/webhook/router-v1' };\n    else if (text.includes('digest')) wf = { id: 'eod_digest', name: 'EOD Scorecard Digest', webhookUrl: 'http://localhost:5678/webhook/eod-scorecard-digest' };\n    ai = { intent: 'run_workflow', targetWorkflow: wf, captureType: 'TASK', parsedTitle: unify.commandText.slice(0, 50), summary: unify.commandText };\n  } else if (text.includes('status') || text.includes('execution') || text.includes('history') || text.includes('vps')) {\n    ai = { intent: 'query_status', captureType: 'NOTE', parsedTitle: 'System Status Query', summary: unify.commandText };\n  } else {\n    let cat = 'NOTE';\n    if (text.startsWith('task:') || text.includes('task ') || text.includes('todo') || text.includes('follow up')) cat = 'TASK';\n    else if (text.startsWith('idea:') || text.includes('idea ') || text.includes('brainstorm')) cat = 'IDEA';\n    else if (text.startsWith('decision:') || text.includes('decision ') || text.includes('agreed')) cat = 'DECISION';\n    ai = { intent: 'second_brain_capture', captureType: cat, parsedTitle: unify.commandText.slice(0, 50), summary: unify.commandText };\n  }\n}\n\nreturn [{\n  json: {\n    commandText: unify.commandText,\n    chatId: unify.chatId,\n    sourceMode: unify.sourceMode,\n    senderName: unify.senderName,\n    intent: ai.intent || 'second_brain_capture',\n    targetWorkflow: ai.targetWorkflow || null,\n    captureType: ai.captureType || 'NOTE',\n    parsedTitle: ai.parsedTitle || unify.commandText.slice(0, 50),\n    summary: ai.summary || unify.commandText,\n    processedAt: new Date().toISOString()\n  }\n}];"
      }
    },
