      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-flash-latest",
          "mode": "list",
          "cachedResultName": "models/gemini-flash-latest"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.commandText && $json.commandText.trim().length > 0 ? $json.commandText : 'Check system health and status' }}"
            }
          ]
        },
        "options": {
          "systemMessage": "You are MAK Operational AI Controller. Analyze the user command or voice transcription.\nCategorize into exactly one intent:\n1. \"run_workflow\": User wants to run/trigger an automation.\n   Registered workflows:\n   - \"health_monitor\": \"n8n Daily Health Monitor\" (keywords: health, check, status of vps) -> webhook: http://localhost:5678/webhook/n8n-health-check\n   - \"backup_engine\": \"Pre-Update Automated Backup\" (keywords: backup, export, snapshot) -> webhook: http://localhost:5678/webhook/trigger-pre-update-backup\n   - \"jev_router\": \"Router Shell v1\" (keywords: jev router, router shell, queue) -> webhook: http://localhost:5678/webhook/router-v1\n   - \"eod_digest\": \"EOD Scorecard Digest\" (keywords: digest, scorecard, eod report) -> webhook: http://localhost:5678/webhook/eod-scorecard-digest\n2. \"query_status\": User wants to see recent executions, workflow failures, or general system health history.\n3. \"second_brain_capture\": Any business task, idea, decision, or note.\n   captureType: \"TASK\" | \"DECISION\" | \"IDEA\" | \"NOTE\"\n\nReturn strictly valid JSON only without markdown formatting:\n{\n  \"intent\": \"run_workflow\" | \"query_status\" | \"second_brain_capture\",\n  \"targetWorkflow\": { \"id\": \"...\", \"name\": \"...\", \"webhookUrl\": \"...\" } or null,\n  \"captureType\": \"TASK\" | \"DECISION\" | \"IDEA\" | \"NOTE\",\n  \"parsedTitle\": \"Short title max 8 words\",\n  \"summary\": \"Clean description of the task or request\"\n}"
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "6sn5MED12JGuINNq",
          "name": "Google Gemini(PaLM) Api account 3"
        }
