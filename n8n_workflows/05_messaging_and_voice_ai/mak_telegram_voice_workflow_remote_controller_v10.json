      "id": "node-ai-decision-engine",
      "name": "AI Decision Engine",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
