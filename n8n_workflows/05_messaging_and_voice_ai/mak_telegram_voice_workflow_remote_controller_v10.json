        "jsCode": "const prev = $('Unpack AI Decision').item.json;\n\nconst text = `\u26a0\ufe0f *WORKFLOW NOT RECOGNIZED*\\n\\n` +\n  `I heard: \\\"${prev.commandText}\\\"\\n\\n` +\n  `Available registered workflows to run:\\n` +\n  `\u2022 *Health Monitor* (\\\"run health check\\\")\\n` +\n  `\u2022 *Backup Engine* (\\\"run backup\\\")\\n` +\n  `\u2022 *Jev Router* (\\\"run jev router\\\")\\n` +\n  `\u2022 *EOD Digest* (\\\"run scorecard digest\\\")\\n\\n` +\n  `_Speak or type one of the registered workflow names._`;\n\nreturn [{ json: { chatId: prev.chatId, message: text } }];"
