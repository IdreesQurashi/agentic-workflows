      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "let items = $input.all();\nlet now = new Date();\nlet filtered = [];\nlet seen = new Set();\n\nfor(let item of items) {\n  let pubDate = new Date(item.json.isoDate || item.json.pubDate || now);\n  let hoursOld = (now - pubDate) / (1000 * 60 * 60);\n  \n  if (hoursOld <= 48 && !seen.has(item.json.title)) {\n    seen.add(item.json.title);\n    filtered.push({\n      json: {\n        title: item.json.title,\n        link: item.json.link,\n        text: item.json.contentSnippet || item.json.content || item.json.title\n      }\n    });\n  }\n}\nreturn filtered;"
      },
      "id": "a7613f9d-ddb0-4a75-bfbc-e1f5300dc1df",
      "name": "Normalize & Filter 48h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "let items = $input.all();\n\n// Parse OpenAI JSON output\nitems.forEach(item => {\n  try {\n    let aiData = JSON.parse(item.json.message.content);\n    item.json.summary = aiData.summary;\n    item.json.importance = aiData.importance;\n  } catch(e) {\n    item.json.summary = 'No summary';\n    item.json.importance = 0;\n  }\n});\n\n// Sort by importance DESC\nitems.sort((a, b) => b.json.importance - a.json.importance);\n\n// Top 5\nlet top5 = items.slice(0, 5);\n\n// Format Email HTML\nlet html = '<h2>\ud83d\udd25 AI Daily Intelligence Digest</h2><br>';\ntop5.forEach((item, i) => {\n  html += `<h3>${i+1}. <a href=\"${item.json.link}\">${item.json.title}</a> (Score: ${item.json.importance}/10)</h3><p>${item.json.summary}</p><br><hr>`;\n});\n\n// Return single item for Gmail to avoid looping\nreturn [{ json: { emailHtml: html, articleCount: top5.length } }];"
      },
