    {
      "name": "Gemini AI Brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        860,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent?key=YOUR_GEMINI_API_KEY_PLACEHOLDER",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "={{ [ { \"parts\": [ { \"text\": \"Write a strict, 2-sentence, hyper-personalized B2B icebreaker about this company based on their description: \" + ($json.data.organization || $json.data.domain) } ] } ] }}"
            }
          ]
        }
      },
      "id": "b37cbc16-abb2-4b33-b077-a87f952be563"
    },
    {
      "name": "Payload Formatting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        160
      ],
      "parameters": {
        "jsCode": "const hunterData = $node[\"Hunter.io Enrichment\"].json.data;\nconst webhookBody = $node[\"Webhook Trigger\"].json.body;\nconst targetEmail = hunterData.emails[0].value;\nlet icebreaker = \"\";\ntry {\n  icebreaker = $input.item.json.candidates[0].content.parts[0].text;\n} catch(e) {\n  icebreaker = \"I loved learning about what you are building.\";\n}\nreturn { email: targetEmail, name: webhookBody.name, domain: webhookBody.domain, icebreaker: icebreaker.trim() };"
      },
      "id": "4451e658-1a5a-4306-a303-12f0d4a56f85"
    },
    {
      "name": "Telegram (Failure Alert)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        860,
        480
      ],
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=Lead failed to enrich: {{$node[\"Webhook Trigger\"].json[\"body\"][\"domain\"]}}"
