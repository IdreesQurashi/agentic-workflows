      "parameters": {
        "jsCode": "const hunterData = $node[\"Hunter.io Enrichment\"].json.data;\nconst webhookBody = $node[\"Webhook Trigger\"].json.body;\n\n// Extract the first email from Hunter\nconst targetEmail = hunterData.emails[0].value;\n\n// Parse Gemini output (handling the nested JSON response)\nlet icebreaker = \"\";\ntry {\n  icebreaker = $input.item.json.candidates[0].content.parts[0].text;\n} catch(e) {\n  icebreaker = \"I loved learning about what you are building.\"; // Fallback\n}\n\n// Format and return clean JSON payload\nreturn {\n  email: targetEmail,\n  name: webhookBody.name,\n  domain: webhookBody.domain,\n  icebreaker: icebreaker.trim()\n};"
      },
